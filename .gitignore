# Compiled binaries from `go build` at the repo root.
/auditprobe
/loadtest

# Wallet key material. These are encrypted, but a key file in git is a key
# that leaks with the repo — including the disposable probe identity, which
# would otherwise let anyone drain whatever it is funded with.
*.sqwallet

# Local state/data directories produced by running a node.
/data/
/chaindata/

# Build outputs that were committed by accident: the macOS/Linux node, wallet
# and deploy binaries, and `qc`, a captured `git log`. The image the tiers run
# is built by CI from source (splendor-infra "Build sqc-node image").
/sqc-node
/sqc-wallet
/sqc-deploy
/node
/wallet
/qc

# macOS finder metadata — never belongs in the tree
.DS_Store
