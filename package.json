{
  "name": "splendor-quantum-blockchain",
  "private": true,
  "version": "0.0.0",
  "description": "Release tooling for the Splendor Quantum Chain node and npm workspaces root for the SDK, widgets and dApp Playground. The chain itself is Go.",
  "type": "module",
  "workspaces": [
    "sdk/sqc-sdk",
    "sdk/connect-react",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "deploy": "node scripts/release.mjs",
    "deploy:devnet": "node scripts/release.mjs patch devnet",
    "deploy:test": "node scripts/release.mjs patch test",
    "deploy:prod": "node scripts/release.mjs patch prod",
    "reset": "node scripts/release.mjs reset",
    "reset:devnet": "node scripts/release.mjs reset devnet",
    "reset:test": "node scripts/release.mjs reset test",
    "reset:prod": "node scripts/release.mjs reset prod",
    "release:status": "node scripts/release.mjs status",
    "readme:tiers": "node scripts/readme-tiers.mjs",
    "lab": "node sdk/connect-react/scripts/feature-lab.mjs",
    "lab:mainnet": "node sdk/connect-react/scripts/feature-lab.mjs --network=mainnet",
    "lab:testnet": "node sdk/connect-react/scripts/feature-lab.mjs --network=testnet",
    "lab:devnet": "node sdk/connect-react/scripts/feature-lab.mjs --network=devnet",
    "lab:fast": "node sdk/connect-react/scripts/feature-lab.mjs --skip-tests",
    "lab:check": "node sdk/connect-react/scripts/feature-lab.mjs --check",
    "build:packages": "npm run build:ts -w @splendor/sqc-sdk && npm run build -w @splendor/connect-react && npm run build -w @splendor/dapp-spec",
    "playground": "npm run build:packages && npm run dev -w @splendor/playground",
    "playground:api": "npm run dev -w @splendor/playground-api",
    "playground:build": "npm run build:packages && npm run build -w @splendor/playground",
    "pack:sdk-vendor": "node scripts/pack-sdk-vendor.mjs",
    "test:webcontainer": "node scripts/webcontainer-smoke.mjs",
    "test:packages": "npm test -w @splendor/sqc-sdk && npm test -w @splendor/connect-react && npm test -w @splendor/dapp-spec && npm test -w create-splendor-dapp",
    "test:playground": "npm test -w @splendor/playground && npm test -w @splendor/playground-api",
    "test:e2e": "npm run e2e -w @splendor/playground",
    "test:codegen": "node scripts/codegen-build-matrix.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --no-audit --no-fund",
    "release-packages": "changeset publish",
    "release-packages:pack": "npm pack --dry-run -w @splendor/sqc-sdk -w @splendor/connect-react -w @splendor/dapp-spec -w create-splendor-dapp"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.29.0"
  },
  "engines": {
    "node": ">=22"
  }
}
