{
  "name": "splendor-quantum-blockchain",
  "private": true,
  "version": "0.0.0",
  "description": "Release tooling for the Splendor Quantum Chain node. The chain itself is Go; this exists so shipping it is one command.",
  "type": "module",
  "scripts": {
    "deploy": "node scripts/release.mjs",
    "deploy:devnet": "node scripts/release.mjs patch devnet",
    "deploy:test": "node scripts/release.mjs patch test",
    "deploy:prod": "node scripts/release.mjs patch prod",
    "reset": "node scripts/release.mjs reset",
    "reset:devnet": "node scripts/release.mjs reset devnet",
    "reset:test": "node scripts/release.mjs reset test",
    "reset:prod": "node scripts/release.mjs reset prod",
    "release:status": "node scripts/release.mjs status",
    "readme:tiers": "node scripts/readme-tiers.mjs",
    "forks": "node scripts/fork-schedule.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
