[Unit]
Description=Splendor Quantum Chain follower (mainnet)
Documentation=https://github.com/Splendor-Protocol/splendor-quantum-blockchain/blob/main/docs/RPC_NODE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sqc
Group=sqc
WorkingDirectory=/opt/sqc
# Mainnet (splendor-quantum-1): the block-0 hash below is mainnet's. Testnet
# values are in docs/RPC_NODE.md. Fill the REPLACE_* placeholders from your
# own derivation, cross-checked against that table, never from the peer alone.
# Do not add --validator, --trust-peer-genesis, or a write-plane token merely
# to pull-sync. install.sh writes its own sqc-rpc.service for validators; this
# unit is a different contract and deliberately has a different name.
#
# The data dir is created here, outside the sandbox: under ProtectSystem=strict
# the node's own mkdir cannot. The reachability wait makes systemd keep
# retrying until the bootnode answers, because the node's genesis bootstrap
# runs once at start and does not retry on its own.
ExecStartPre=+/usr/bin/install -d -o sqc -g sqc -m 750 /var/sqc /var/sqc/data
ExecStartPre=/usr/bin/curl -fsS --max-time 10 --retry 5 --retry-delay 10 --retry-all-errors -o /dev/null https://quantum-rpc.splendor.org/status
ExecStart=/opt/sqc/sqc-node \
    --data-dir /var/sqc/data \
    --rpc-addr 127.0.0.1:8080 \
    --chain-id splendor-quantum-1 \
    --genesis-hash ba748263713642d619abb7c4b4d596cddc0d9429f296c438beacf3e656510949 \
    --genesis-doc-hash REPLACE_GENESIS_DOC_HASH \
    --peer https://quantum-rpc.splendor.org \
    --peer-pin https://quantum-rpc.splendor.org=REPLACE_PEER_IDENTITY_HEX \
    --require-peer-pins \
    --log-level info
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sqc-follower
LimitNOFILE=65535
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/sqc/data

[Install]
WantedBy=multi-user.target
