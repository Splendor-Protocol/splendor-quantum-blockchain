[Unit]
Description=Splendor Quantum Chain RPC follower
Documentation=https://github.com/Splendor-Protocol/splendor-quantum-blockchain
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sqc
Group=sqc
WorkingDirectory=/opt/sqc
# Replace the REPLACE_* placeholders from the published network manifest.
# Do not add --validator, --trust-peer-genesis, or a write-plane token
# merely to pull-sync. See docs/RPC_NODE.md.
ExecStart=/opt/sqc/sqc-node \
    --data-dir /var/sqc/data \
    --rpc-addr 127.0.0.1:8080 \
    --genesis-hash ba748263713642d619abb7c4b4d596cddc0d9429f296c438beacf3e656510949 \
    --genesis-doc-hash REPLACE_GENESIS_DOC_HASH \
    --peer REPLACE_BOOTNODE_URL \
    --peer-pin REPLACE_BOOTNODE_URL=REPLACE_PEER_IDENTITY_HEX \
    --require-peer-pins \
    --log-level info
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sqc-rpc
LimitNOFILE=65535
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/sqc/data

[Install]
WantedBy=multi-user.target
