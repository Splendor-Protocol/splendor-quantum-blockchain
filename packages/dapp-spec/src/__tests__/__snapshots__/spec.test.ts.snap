            heading={"Dashboard"}
            text={"Your balance, your token and your contract in one place."}
          />
          <div className="dapp-row" data-node-id="app-top"
            style={{ gap: "1rem", alignItems: "stretch" }}>
            <div className="dapp-column" data-node-id="app-top-left"
              style={{ gap: "1rem" }}>
              <AccountCard showBalance showNetwork showExplorer />
            </div>
