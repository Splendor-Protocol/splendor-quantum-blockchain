{
  "app/HomePage.tsx": "'use client';

import { HeroCentered } from '../blocks/HeroCentered';
import { LiveStat } from '../blocks/LiveStat';
import { FeatureGrid } from '../blocks/FeatureGrid';
import { CtaBanner } from '../blocks/CtaBanner';
import { FooterBar } from '../blocks/FooterBar';
import { CONTRACTS } from './contracts';

export function HomePage() {
  return (
    <div className="dapp-page">
      <div className="dapp-section" data-node-id="landing-root"
        style={{ maxWidth: "1120px", gap: "1.25rem", padding: "1.25rem" }}>
        <HeroCentered
          heading={"My contract"}
          text={"Live numbers straight from the contract. Sign in to take part."}
          ctaLabel={"Open the app"}
          ctaPath={"/app"}
        />
        <div className="dapp-row" data-node-id="landing-stats"
          style={{ gap: "1rem", alignItems: "stretch" }}>
          <div className="dapp-column" data-node-id="landing-stat-1"
            style={{ gap: "1rem" }}>
            <LiveStat
              label={"Get"}
              functionSig={"get()"}
              format={"number"}
              refreshMs={0}
              fnParams={"[]"}
              contract={CONTRACTS["app"].address}
            />
          </div>
        </div>
        <FeatureGrid
          title={"How it works"}
          items={"Read|Anyone can see the live numbers\\nSign in|Prove your wallet with a free signature\\nAct|Send transactions from the dashboard"}
        />
        <CtaBanner
          heading={"Take part"}
          text={"Sign in with your Splendor wallet."}
          buttonLabel={"Open the app"}
          buttonPath={"/app"}
        />
        <FooterBar text={"Built with the Splendor dApp Studio"} />
      </div>
    </div>
  );
}
",
  "app/app/AppPage.tsx": "'use client';

import { AccountCard } from '@splendor/connect-react';
import { Hero } from '../../blocks/Hero';
import { LiveStat } from '../../blocks/LiveStat';
import { ContractForm } from '../../blocks/ContractForm';
import { TxHistoryTable } from '../../blocks/TxHistoryTable';
import { AccessGate } from '../../blocks/AccessGate';
import { CONTRACTS } from '../contracts';

export function AppPage() {
  return (
    <div className="dapp-page">
      <AccessGate access="signin" title={"Dashboard"}>
        <div className="dapp-section" data-node-id="app-root"
          style={{ maxWidth: "1120px", gap: "1.25rem", padding: "1.25rem" }}>
          <Hero heading={"Dashboard"} text={"Read and write My contract."} />
          <div className="dapp-row" data-node-id="app-top"
            style={{ gap: "1rem", alignItems: "stretch" }}>
            <div className="dapp-column" data-node-id="app-top-left"
              style={{ gap: "1rem" }}>
              <AccountCard showBalance showNetwork />
            </div>
            <div className="dapp-column" data-node-id="app-stat-1"
              style={{ gap: "1rem" }}>
              <LiveStat
                label={"Get"}
                functionSig={"get()"}
                format={"number"}
                refreshMs={0}
                fnParams={"[]"}
                contract={CONTRACTS["app"].address}
              />
            </div>
          </div>
          <ContractForm
            title={"Set"}
            functionSig={"set(uint256)"}
            buttonLabel={"Set"}
            successMessage={"Transaction sent."}
            fnParams={"[\\u007b\\"name\\":\\"value\\",\\"type\\":\\"uint256\\"\\u007d]"}
            contract={CONTRACTS["app"].address}
          />
          <ContractForm
            title={"Increment"}
            functionSig={"increment()"}
            buttonLabel={"Increment"}
            successMessage={"Transaction sent."}
            fnParams={"[]"}
            contract={CONTRACTS["app"].address}
          />
          <TxHistoryTable title={"Recent transactions"} limit={10} />
        </div>
      </AccessGate>
    </div>
  );
}
",
}
`;

