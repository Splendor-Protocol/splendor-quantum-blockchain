{
  "app/HomePage.tsx": "'use client';

import { AccountCard } from '@splendor/connect-react';
import { Hero } from '../blocks/Hero';
import { MembersArea } from '../blocks/MembersArea';

export function HomePage() {
  return (
    <div className="dapp-grid">
      <Hero heading={"Members club"} text={"Sign in with your wallet — no passwords, no email."} />
      <MembersArea
        title={"Members area"}
        statement={"Sign in to the members club"}
        content={"Welcome back! Here is this week's members-only update."}
      />
      <AccountCard showBalance={false} />
    </div>
  );
}
",
}
`;

