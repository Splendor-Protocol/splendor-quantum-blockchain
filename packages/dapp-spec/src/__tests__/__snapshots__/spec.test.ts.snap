{
  "app/HomePage.tsx": "'use client';

import { HeroCentered } from '../blocks/HeroCentered';
import { FeatureGrid } from '../blocks/FeatureGrid';
import { CtaBanner } from '../blocks/CtaBanner';
import { Faq } from '../blocks/Faq';
import { FooterBar } from '../blocks/FooterBar';

export function HomePage() {
  return (
    <div className="dapp-page">
      <div className="dapp-section" data-node-id="home-root"
        style={{ maxWidth: "1120px", gap: "1rem", padding: "1.25rem" }}>
        <div className="dapp-stack" data-node-id="home-root-stack"
          style={{ gap: "1rem" }}>
          <HeroCentered
            heading={"Build on Splendor"}
            text={"Post-quantum dApps without the boilerplate."}
            ctaLabel={"Open app"}
            ctaPath={"/app"}
          />
          <FeatureGrid
            title={"Why Splendor"}
            items={"Wallet ready|Drop-in connect kit,Tokens|QRC-20 and NFT modules,Contracts|Bind any deployed ABI"}
          />
          <CtaBanner
            heading={"Ready to ship?"}
            text={"Export a Vite or Next.js project in one click."}
            buttonLabel={"Start building"}
            buttonPath={"/app"}
          />
          <Faq
            title={"FAQ"}
            items={"Is it post-quantum?|Yes — ML-DSA-65 signatures.,Do I need a wallet?|Use the extension or an in-page seed."}
          />
          <FooterBar text={"Built with the Splendor dApp Studio"} />
        </div>
      </div>
    </div>
  );
}
",
  "app/app/AppPage.tsx": "'use client';

import { AccountCard, TransferWidget } from '@splendor/connect-react';
import { Hero } from '../../blocks/Hero';

export function AppPage() {
  return (
