export function HomePage() {
  return (
    <div className="dapp-grid">
      <Hero heading={"Wallet dashboard"} text={"Your Splendor account at a glance."} />
      <AccountCard showBalance showNetwork showExplorer showDisconnect />
      <TransferWidget defaultAmount={"0.01"} showFee toast />
      <PendingTxList emptyText={"Nothing pending"} pollMs={5000} />
    </div>
  );
}
",
}
`;

