            style={{ gap: "1rem", alignItems: "stretch" }}>
            <div className="dapp-column" data-node-id="app-actions-left"
              style={{ gap: "1rem" }}>
              <TokenPanel
                tokenAddress={"SQ:dededededededededededededededededededededededededededededededede"}
                defaultAmount={"1"}
                showFee
                toast
              />
            </div>
            <div className="dapp-column" data-node-id="app-actions-right"
              style={{ gap: "1rem" }}>
              <LiveStat
                label={"Current value"}
                functionSig={"get()"}
                format={"number"}
                refreshMs={0}
                fnParams={"[]"}
                contract={CONTRACTS["app"].address}
              />
              <ContractForm
                title={"Update the value"}
                functionSig={"set(uint256)"}
                buttonLabel={"Save on-chain"}
                successMessage={"Saved."}
                fnParams={"[\\u007b\\"name\\":\\"value\\",\\"type\\":\\"uint256\\"\\u007d]"}
                contract={CONTRACTS["app"].address}
              />
            </div>
          </div>
          <TxHistoryTable title={"Recent transactions"} limit={10} />
        </div>
      </AccessGate>
    </div>
  );
}
",
}
