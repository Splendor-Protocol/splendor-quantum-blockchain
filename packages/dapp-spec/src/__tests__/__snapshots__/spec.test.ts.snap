{
  "app/HomePage.tsx": "'use client';

import { AccountCard, DeployTokenWidget } from '@splendor/connect-react';
import { Hero } from '../blocks/Hero';

export function HomePage() {
  return (
    <div className="dapp-grid">
      <Hero heading={"Launch your token"} text={"Deploy a QRC-20 token in one transaction."} />
      <DeployTokenWidget
        defaultName={"My Token"}
        defaultSymbol={"MYT"}
        defaultSupply={"1000000"}
        decimals={18}
        review
        showFee
        toast
      />
      <AccountCard showBalance />
    </div>
  );
}
",
  "app/manage/ManagePage.tsx": "'use client';

import { PendingTxList, TokenPanel } from '@splendor/connect-react';

export function ManagePage() {
  return (
    <div className="dapp-grid">
      <TokenPanel defaultAmount={"1"} showFee toast />
      <PendingTxList pollMs={5000} />
    </div>
  );
}
",
}
`;

