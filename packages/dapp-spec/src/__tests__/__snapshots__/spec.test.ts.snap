      <div className="dapp-section" data-node-id="app-root"
        style={{ maxWidth: "1120px", gap: "1rem", padding: "1.25rem" }}>
        <div className="dapp-stack" data-node-id="app-root-stack"
          style={{ gap: "1rem" }}>
          <Hero heading={"Your app"} text={"Connect and try it live."} />
          <AccountCard showBalance showNetwork />
          <TransferWidget defaultAmount={"0.01"} showFee toast />
        </div>
      </div>
    </div>
  );
}
",
}
`;

