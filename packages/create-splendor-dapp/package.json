  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "splendor",
    "dapp",
    "create",
    "scaffold",
    "post-quantum"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
