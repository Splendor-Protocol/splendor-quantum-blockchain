{
  "name": "@splendor/playground-api",
  "version": "0.1.0",
  "private": true,
  "description": "API for the Splendor dApp Playground: wallet sign-in, projects, catalog flags, release dispatch and audit log.",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@splendor/connect-react": "3.0.0",
    "@splendor/dapp-spec": "0.1.0",
    "@splendor/sqc-sdk": "3.0.0",
    "fastify": "^5.12.7",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
