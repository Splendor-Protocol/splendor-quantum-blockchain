# Copy to .env.local (never commit real values).
PORT=8787
HOST=127.0.0.1

# sqlite:./data/playground.db for development, postgres://user:pass@host:5432/db for production
DATABASE_URL=sqlite:./data/playground.db

# Browser origins of the playground (comma separated). Also the allowed sign-in domains.
PLAYGROUND_ORIGINS=http://localhost:5180,http://127.0.0.1:5180

# Always-admin wallet addresses (comma separated SQ: addresses). More can be added in the admin UI.
ADMIN_ADDRESSES=

# Optional: require sign-in messages for this chain id. Messages without a Chain ID are refused.
# SIGNIN_CHAIN_ID=splendor-quantum-testnet-1

# Peers allowed to set X-Forwarded-For (addresses, CIDRs or "loopback"). Leave unset when the API
# is reached directly; set it (e.g. loopback) when it runs behind your reverse proxy.
# TRUST_PROXY=true (every peer) is refused in production unless TRUST_PROXY_ALLOW_ALL=1.
# TRUST_PROXY=loopback

# Audit rows older than this many days are deleted by the housekeeping job (default 365).
# AUDIT_RETENTION_DAYS=365

# Session cookie. In production COOKIE_SECURE defaults to 1, and a Secure cookie is named
# __Host-sqc_pg_session (host-only, path /).
# COOKIE_SECURE=1
# Use "none" only when the playground and API are on different sites (requires COOKIE_SECURE=1).
# COOKIE_SAMESITE=lax
# SESSION_TTL_SEC=604800

# Release dashboard: fine-grained token with Actions: read/write and Contents: read on this repo ONLY.
# npm credentials stay in GitHub secrets; this API never sees them.
# GITHUB_TOKEN=
# GITHUB_REPO=Splendor-Protocol/splendor-quantum-blockchain
# GITHUB_RELEASE_WORKFLOW=release-packages.yml
# GITHUB_RELEASE_REF=main
# Only for GitHub Enterprise or an npm registry mirror:
# GITHUB_API_URL=https://api.github.com
# NPM_REGISTRY_URL=https://registry.npmjs.org

# "Push to GitHub" with each user's own account: a GitHub OAuth App (Settings → Developer settings →
# OAuth Apps). Callback URL: <playground origin>/api/integrations/github/callback. All three are needed;
# in production a client id without INTEGRATION_TOKEN_KEY is refused. GITHUB_TOKEN above is NOT used for this.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# 32 random bytes that seal users' GitHub tokens at rest: openssl rand -base64 32
# INTEGRATION_TOKEN_KEY=
# public_repo (default) or repo (also private repositories).
# GITHUB_OAUTH_SCOPE=public_repo
# Only when the callback differs from the OAuth App's registered one, or for GitHub Enterprise:
# GITHUB_OAUTH_CALLBACK_URL=https://studio.example.com/api/integrations/github/callback
# GITHUB_OAUTH_WEB_URL=https://github.com

# Unused stub: hosted publishing routes (/deployments). Off by default; users deploy to their own host.
# HOSTING_ENABLED=1

# Tests only: enables POST /auth/test-login. Refused when NODE_ENV=production or HOST is not loopback.
# ALLOW_TEST_LOGIN=1
