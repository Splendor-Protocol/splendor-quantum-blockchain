{
  "name": "@splendor/connect-react",
  "version": "1.3.0",
  "description": "AppKit-style React connect UI kit for Splendor Quantum Chain. Modular connectors unlock @splendor/sqc-sdk WASM ML-DSA-65 wallets.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sqc-copy-wasm": "./scripts/copy-wasm-assets.mjs",
    "create-splendor-dapp": "./scripts/create-splendor-dapp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./connectors": {
      "types": "./dist/connectors.d.ts",
      "import": "./dist/connectors.js"
    },
    "./core": {
      "types": "./dist/core-public.d.ts",
      "import": "./dist/core-public.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./widgets": {
      "types": "./dist/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./style.css": "./dist/theme/tokens.css"
  },
  "sideEffects": [
    "./dist/theme/tokens.css",
    "**/*.css"
  ],
  "files": [
    "dist",
    "scripts",
    "create-template",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-css.mjs",
    "test": "vitest run",
    "prepare": "npm run build",
    "copy-wasm": "node ./scripts/copy-wasm-assets.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@splendor/sqc-sdk": ">=2.0.0",
    "react": ">=18",
    "react-dom": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@splendor/sqc-sdk": "file:../sqc-sdk",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "splendor",
    "post-quantum",
    "react",
    "wallet",
    "connect",
    "ui-kit"
  ],
  "license": "MIT"
}
