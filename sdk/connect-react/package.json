{
  "name": "@splendor/connect-react",
  "version": "1.0.0",
  "description": "AppKit-style React connect UI kit for Splendor Quantum Chain. Modular connectors unlock @splendor/pq-bridge WASM Dilithium wallets.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/theme/tokens.css"
  },
  "sideEffects": [
    "./dist/theme/tokens.css",
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/copy-css.mjs",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "@splendor/pq-bridge": ">=1.3.0"
  },
  "devDependencies": {
    "@splendor/pq-bridge": "file:../bridge",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "splendor",
    "post-quantum",
    "react",
    "wallet",
    "connect",
    "ui-kit"
  ],
  "license": "MIT"
}
