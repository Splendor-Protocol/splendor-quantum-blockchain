# Copy to .env.local and edit. Unset values fall back to the SDK built-ins
# (sdk/sqc-sdk/src/config/sqc.networks.json), which already contain these defaults.

# Network the lab starts on: mainnet | testnet | devnet | local
VITE_SQC_NETWORK=mainnet

# Mainnet
VITE_SQC_MAINNET_RPC_URL=https://quantum-rpc.splendor.org
VITE_SQC_MAINNET_CHAIN_ID=splendor-quantum-1
VITE_SQC_MAINNET_EXPLORER_URL=https://quantum-explorer.splendor.org

# Testnet
VITE_SQC_TESTNET_RPC_URL=https://quantum-rpc-testnet.splendor.org
VITE_SQC_TESTNET_CHAIN_ID=splendor-quantum-testnet-1
VITE_SQC_TESTNET_EXPLORER_URL=https://quantum-testnet-explorer.splendor.org

# Devnet
VITE_SQC_DEVNET_RPC_URL=https://quantum-rpc-devnet.splendor.org
VITE_SQC_DEVNET_CHAIN_ID=splendor-quantum-devnet-1
VITE_SQC_DEVNET_EXPLORER_URL=https://quantum-devnet-explorer.splendor.org

# Talk to RPCs directly instead of the localhost /rpc/<id> proxy (only if CORS allows your origin)
# VITE_SQC_DIRECT_RPC=1

# Required for production builds (npm run build / --preview)
# VITE_SQC_WASM_SHA256=
