{
  "name": "@splendor/sqc-sdk",
  "version": "2.0.0",
  "description": "Splendor Quantum Chain SDK — wallet, tokens, contracts, and native module clients. ML-DSA-65 signing via Go WASM.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {
    "./dist/wasm-loader.node.js": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./wallet": {
      "types": "./dist/wallet/index.d.ts",
      "import": "./dist/wallet/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js"
    },
    "./tokens/qrc20": {
      "types": "./dist/tokens/qrc20.d.ts",
      "import": "./dist/tokens/qrc20.js"
    },
    "./tokens/qrc1155": {
      "types": "./dist/tokens/qrc1155.d.ts",
      "import": "./dist/tokens/qrc1155.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./defi": {
      "types": "./dist/defi/index.d.ts",
      "import": "./dist/defi/index.js"
    },
    "./bridge": {
      "types": "./dist/bridge/index.d.ts",
      "import": "./dist/bridge/index.js"
    },
    "./x402": {
      "types": "./dist/x402/index.d.ts",
      "import": "./dist/x402/index.js"
    },
    "./addresses": {
      "types": "./dist/addresses/index.d.ts",
      "import": "./dist/addresses/index.js"
    },
    "./networks": {
      "types": "./dist/networks.d.ts",
      "import": "./dist/networks.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./verify": {
      "types": "./dist/verify.d.ts",
      "import": "./dist/verify.js"
    },
    "./validators": {
      "types": "./dist/validators.d.ts",
      "import": "./dist/validators.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "import": "./dist/units.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "sideEffects": [
    "./dist/wasm-loader*.js",
    "./dist/browser.js"
  ],
  "files": [
    "dist",
    "wasm/dist",
    "config",
    "README.md",
    "docs"
  ],
  "scripts": {
    "sync:config": "node ./scripts/sync-config.mjs",
    "build:wasm": "powershell -ExecutionPolicy Bypass -File ./wasm/build.ps1",
    "build:wasm:sh": "bash ./wasm/build.sh",
    "prebuild:ts": "npm run sync:config",
    "build:ts": "tsc -p tsconfig.json",
    "build": "npm run build:ts",
    "prepare": "npm run build:ts",
    "prepack": "bash ./wasm/build.sh && node ./scripts/sync-config.mjs && npm run build:ts && node ./scripts/check-wasm-dist.mjs",
    "test": "vitest run",
    "test:go": "go test github.com/splendor-protocol/splendor-quantum-blockchain/sdk/sqc-sdk/signer -count=1",
    "test:gateway": "npm --prefix gateway test",
    "test:security": "vitest run security- && npm run test:go && npm run test:gateway",
    "test:e2e": "node examples/e2e-offline.mjs",
    "test:live": "node examples/live-e2e.mjs",
    "example:node": "node examples/node-transfer.mjs",
    "example:one-touch": "node examples/one-touch.mjs",
    "gateway:smoke": "node examples/gateway-smoke.mjs"
  },
  "engines": {
    "node": ">=22.20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "splendor",
    "post-quantum",
    "ml-dsa",
    "sqc-sdk",
    "qrc20",
    "wasm"
  ],
  "license": "MIT"
}
