    "minFee": "1000",
    "addressPrefix": "SQ:",
    "addressHexLen": 64,
    "confirmation": "nonce",
    "abiHash": "sha3-256",
    "goldenTransferSelector": "14cde9ab",
    "derivationDomainVersion": "v1",
    "bridgeClientVersion": "1.3.0"
  },
  "networks": {
