      "timeoutMs": 20000,
      "retries": 3
    },
    "mainnet": {
      "id": "mainnet",
      "name": "Splendor Quantum Mainnet",
      "chainId": "splendor-quantum-1",
      "rpcUrls": ["https://rpc.splendor.example"],
      "gatewayUrl": "https://gateway.splendor.example",
      "gatewayPort": 443,
      "wasmUrl": "/sqc_signer.wasm",
      "execUrl": "/wasm_exec.js",
      "timeoutMs": 20000,
      "retries": 3
    }
  }
